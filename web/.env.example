# Supabase. Both of these are safe to expose in the browser: the publishable
# key is the same one already printed in yaadly.co.uk's JavaScript. Row level
# security is what protects the data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=https://leffyisvfvjwzilydlwf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# HubSpot private app token, for web/lib/hubspotPipeline.ts. Starts with "pat-".
#
# SERVER SIDE ONLY, and unlike the two values above it is a real secret. It has
# no NEXT_PUBLIC_ prefix on purpose: that prefix inlines a value into the
# browser bundle at build time, which would publish the token to anyone who
# opens devtools.
#
# Needs crm.objects.deals.read AND crm.objects.deals.write. Read alone lets the
# portal be inspected but makes every stage move fail with a 403.
#
# In production this is a Worker secret, not a build variable:
#   wrangler secret put HUBSPOT_TOKEN
# Leave it unset and nothing HubSpot-related runs. Nothing else breaks.
HUBSPOT_TOKEN=

# Shared secret for the inbound webhook at /api/hubspot/stage.
#
# The sender signs `${unix_seconds}.${raw_body}` with HMAC-SHA256 and sends the
# hex digest as x-yaadly-signature, with the timestamp as x-yaadly-timestamp.
#
# Unlike WHATSAPP_APP_SECRET, leaving this unset does NOT skip verification. The
# endpoint returns 503 and refuses everything, because a request it cannot
# verify could otherwise mark a client's money as held when it is not.
#
# Generate one with:  openssl rand -hex 32
# Production: wrangler secret put HUBSPOT_STAGE_WEBHOOK_SECRET
HUBSPOT_STAGE_WEBHOOK_SECRET=
