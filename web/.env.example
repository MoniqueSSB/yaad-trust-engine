# Supabase. Both of these are safe to expose in the browser: the publishable
# key is the same one already printed in yaadly.co.uk's JavaScript. Row level
# security is what protects the data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=https://leffyisvfvjwzilydlwf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# HubSpot private app token, for web/lib/hubspotPipeline.ts. Starts with "pat-".
#
# SERVER SIDE ONLY, and unlike the two values above it is a real secret. It has
# no NEXT_PUBLIC_ prefix on purpose: that prefix inlines a value into the
# browser bundle at build time, which would publish the token to anyone who
# opens devtools.
#
# Needs crm.objects.deals.read AND crm.objects.deals.write. Read alone lets the
# portal be inspected but makes every stage move fail with a 403.
#
# In production this is a Worker secret, not a build variable:
#   wrangler secret put HUBSPOT_TOKEN
# Leave it unset and nothing HubSpot-related runs. Nothing else breaks.
HUBSPOT_TOKEN=

# Shared secret for the inbound webhook at /api/hubspot/stage.
#
# The sender signs `${unix_seconds}.${raw_body}` with HMAC-SHA256 and sends the
# hex digest as x-yaadly-signature, with the timestamp as x-yaadly-timestamp.
#
# Unlike WHATSAPP_APP_SECRET, leaving this unset does NOT skip verification. The
# endpoint returns 503 and refuses everything, because a request it cannot
# verify could otherwise mark a client's money as held when it is not.
#
# Generate one with:  openssl rand -hex 32
# Production: wrangler secret put HUBSPOT_STAGE_WEBHOOK_SECRET
HUBSPOT_STAGE_WEBHOOK_SECRET=

# Shared secret for the inbound webhook at /api/hubspot/lead, which turns a
# confirmed WhatsApp job into a contact and a deal. Same signing scheme as
# above, its own secret on purpose: a leak of one must not hand over the other,
# and these do very different things. That one moves a deal along a money
# pipeline; this one creates records.
#
# THIS IS THE SWITCH FOR THE WHOLE FEATURE. yaad-inbound reads the same value
# as a Supabase secret and does nothing at all while it is unset, so leaving it
# blank means no client data reaches HubSpot. Setting it turns the sync on.
#
# ONE HubSpot deal property must exist first (yaadly_job_id, single-line text)
# or the first real lead fails: see RUNBOOK.md, "Turning the HubSpot lead sync
# on". It is the idempotency key, so it cannot be skipped.
#
# Generate one with:  openssl rand -hex 32
# Production: wrangler secret put HUBSPOT_LEAD_WEBHOOK_SECRET
#         and supabase secrets set HUBSPOT_LEAD_WEBHOOK_SECRET=... --project-ref leffyisvfvjwzilydlwf
HUBSPOT_LEAD_WEBHOOK_SECRET=

# Persona, the identity vendor behind step 3 of /apply. Both values are safe in
# the browser: they name a verification template and an environment, they
# authorise nothing, and the flow they open still ends with OUR server asking
# Persona's API what actually happened.
#
# Where they live in the Persona dashboard (app.withpersona.com):
#   template id     Inquiries → Templates → your Government ID + Selfie
#                   template → starts "itmpl_"
#   environment id  either a real "env_..." id, or simply the word "sandbox"
#                   or "production". The dashboard's environment picker only
#                   shows the names, so the words are the practical option.
#                   Sandbox is simulated data and never verifies a real person:
#                   fine for the trial, wrong for a live applicant.
#
# Leave BOTH unset and /apply runs the in-page capture instead. Nothing breaks.
NEXT_PUBLIC_PERSONA_TEMPLATE_ID=
NEXT_PUBLIC_PERSONA_ENVIRONMENT_ID=

# The Persona API key is NOT set here and must never carry a NEXT_PUBLIC_
# prefix: it is a real secret and it belongs to the yaad-vetting-upload edge
# function, which uses it to confirm an inquiry server-side. Set it with:
#   supabase secrets set PERSONA_API_KEY=persona_... --project-ref leffyisvfvjwzilydlwf
# Unset, the inquiry is still recorded, marked "unchecked", and the desk
# confirms it by hand in the Persona dashboard.
