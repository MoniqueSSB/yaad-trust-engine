{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yaadly-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // The portal's real address. Activates on deploy once the yaadly.co.uk
  // zone is live on Cloudflare (it is added and waiting on the Phase8
  // nameserver change). Until then this line must stay commented or the
  // deploy fails.
  // "routes": [{ "pattern": "app.yaadly.co.uk", "custom_domain": true }]
  // Public env vars are set at build time from .env.local / .env.production.
  // Anything genuinely secret goes in `wrangler secret put NAME`, never here:
  // this file is committed to a public repository.
}
