{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yaadly-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // The portal's real address. The yaadly.co.uk zone went active on
  // Cloudflare on 26 Aug 2026, so this deploys live.
  "routes": [{ "pattern": "app.yaadly.co.uk", "custom_domain": true }]
  // Public env vars are set at build time from .env.local / .env.production.
  // Anything genuinely secret goes in `wrangler secret put NAME`, never here:
  // this file is committed to a public repository.
}
