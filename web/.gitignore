# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template is not a configuration, it is documentation, and it has
# to survive a fresh clone. check-env.mjs tells you to build .env.local "from
# web/.env.example", which was impossible: the blanket rule above ignored the
# example too, so the one file that explains the setup never shipped with the
# checkout that needed it. Matches the root .gitignore, which negates it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cloudflare Workers / OpenNext
.open-next/
.wrangler/
cloudflare-env.d.ts
