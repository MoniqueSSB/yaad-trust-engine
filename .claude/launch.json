{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "concierge",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8931",
        "--directory",
        "concierge"
      ],
      "port": 8931
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8932",
        "--directory",
        "docs"
      ],
      "port": 8932
    },
    {
      "name": "preview-alt",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8934",
        "--directory",
        "preview"
      ],
      "port": 8934
    },
    {
      "name": "site-alt",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8933",
        "--directory",
        "docs"
      ],
      "port": 8933
    },
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}
