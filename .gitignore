.env
__pycache__/
*.pyc
.pytest_cache/
out/
*.sql
# ...but schema and tests are source code and belong in the repo.
!supabase/migrations/*.sql
!supabase/tests/*.sql
# Seed rigs are tooling, not data. They carry no credentials: the one
# password they need is passed in at run time, because this repo is public.
!supabase/seeds/*.sql
*.sql.gz
*.dump
backups/
.yaadly/
*.env
!.env.example

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# Supabase CLI scratch
supabase/.temp/

# wrangler's local build and state cache
.wrangler/

# npm. web/ has had its own rule since it was created; concierge-deploy needs
# one too, and a repo-wide rule means the next folder with a package.json is
# covered before anybody runs install in it.
node_modules/
