{
  // The admin desk, deployed on its own Worker and its own hostname.
  //
  // Separate from yaadly.co.uk and from app.yaadly.co.uk on purpose. The desk
  // reads client addresses, worker vetting status and money. It has no
  // business sharing an origin with the marketing site, where a single bad
  // script tag would be sitting next to it, or with the client app, where
  // every signed-in client is already executing code.
  //
  // Separate origin also means separate cookies. Nothing the desk stores can
  // be read by anything on the other two hosts, and vice versa.
  //
  // What protects the data is still the sign-in gate plus is_admin() and RLS
  // underneath. This removes the shared blast radius; it does not replace the
  // lock. Put Cloudflare Access in front of this hostname and it stops being
  // reachable at all without an identity check first.
  "name": "yaadly-concierge",
  "compatibility_date": "2026-08-01",
  // A real hostname in the zone, because Cloudflare Access cannot be applied
  // to a workers.dev address. This is the thing that lets the desk sit behind
  // an identity check rather than behind a URL nobody has guessed yet.
  "routes": [{ "pattern": "concierge.yaadly.co.uk", "custom_domain": true }],
  "main": "./src/index.ts",
  // binding, so the Worker can serve the asset and then add headers to it
  // run_worker_first, because a matching asset is otherwise served straight
  // from the edge and the Worker never runs, which is why the headers were
  // missing the first time this was tried.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true }
}
