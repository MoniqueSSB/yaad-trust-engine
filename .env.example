# Copy to .env and fill in. Never commit .env.
# Leave YAAD_API_KEY unset to run the whole pipeline in labelled mock mode.

YAAD_API_KEY=
YAAD_BASE_URL=https://ht.getimpala.ai/v1
YAAD_MODEL=qwen3.6-27b
YAAD_TEMPERATURE=0.2
YAAD_TIMEOUT=60

# HubSpot private app token (starts with "pat-").
#
# Read scopes are enough to inspect the portal. Moving a deal along the
# pipeline is a WRITE, so web/lib/hubspotPipeline.ts also needs
# crm.objects.deals.write. Without it every stage move fails with a 403 that
# no retry will ever clear.
#
# Server side only. Never give this a NEXT_PUBLIC_ prefix: that would inline
# it into the browser bundle at build time and publish the token.
HUBSPOT_TOKEN=
